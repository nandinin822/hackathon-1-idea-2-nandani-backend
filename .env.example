# ==========================================
# Application Configuration (.env.example)
# Copy this file to .env for local development
# NEVER commit your actual .env file to git
# ==========================================

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# Server port (default 8000 for local development)
PORT=8000

# CORS Allowed Origins
# Comma-separated list of origins permitted to access this backend.
# Local development default: http://localhost:5173 (standard Vite dev server)
# Production example: https://your-app-name.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External Provider: Duffel API
# Sandbox / Live API access token (duffel_test_... or duffel_live_...)
# Keep empty or set your test token in local .env
DUFFEL_API_KEY=
